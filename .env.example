# Environment Variables for ART Member Listening Intelligence Hub
# Copy this file to .env and fill in your actual values

# ============================================================================
# Slack Integration
# ============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# SMS Alerts (Twilio)
# ============================================================================
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# Email Alerts (SMTP)
# ============================================================================
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=alerts@art.com.au
SMTP_FROM_NAME=ART Member Intelligence

# ============================================================================
# Salesforce Integration
# ============================================================================
SALESFORCE_USERNAME=your-username@example.com
SALESFORCE_PASSWORD=your-password
SALESFORCE_SECURITY_TOKEN=your-security-token
SALESFORCE_DOMAIN=test  # Use 'test' for sandbox/dev, leave empty for production

# Optional: OAuth credentials (if using Connected App)
# SALESFORCE_CLIENT_ID=your-client-id
# SALESFORCE_CLIENT_SECRET=your-client-secret

# ============================================================================
# Dashboard Configuration
# ============================================================================
DASH_DEBUG=True
DASH_PORT=8050
DASH_HOST=0.0.0.0

# ============================================================================
# Databricks Configuration (if running locally)
# ============================================================================
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=your-personal-access-token
